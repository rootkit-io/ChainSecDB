# Local development only. Production must supply its own DATABASE_URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/security_research
# Tests create and remove their own schema in this database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/security_research
# Optional: required only when explicitly using the internal OpenAI provider.
# Set a real key locally; never commit it. Choose a model supporting Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Provider request timeout in seconds (1-600); no automatic retries.
OPENAI_TIMEOUT_SECONDS=180
